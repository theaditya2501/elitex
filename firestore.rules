rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true)
        || request.auth.token.email == "admin@elitexgamers.com"
        || request.auth.token.email == "elitexgamers.official@gmail.com"
      );
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isAdmin() || (signedIn() && (request.auth.token.email == "admin@elitexgamers.com" || request.auth.token.email == "elitexgamers.official@gmail.com"));
    }

    // Users
    match /users/{userId} {
      allow read: if true;
      allow create: if isUser(userId);
      allow update: if isUser(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Wallets: Read user own wallet; admin can update; user can create initial wallet
    match /wallets/{walletId} {
      allow read: if isUser(walletId) || isAdmin();
      allow create: if isUser(walletId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Wallet Transactions
    match /walletTransactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Legacy transactions collection support
    match /transactions/{transactionId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
      allow write: if isAdmin();
    }

    // Deposits
    match /deposits/{depositId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Legacy deposit requests support
    match /depositRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Withdrawals
    match /withdrawals/{withdrawalId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Legacy withdrawal requests support
    match /withdrawalRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.uid == request.auth.uid || resource.data.userId == request.auth.uid));
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Tournaments & subcollections
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();

      match /entries/{entryId} {
        allow read: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }

      match /joins/{joinId} {
        allow read: if true;
        allow create: if signedIn();
        allow update, delete: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      }

      match /matches/{matchId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /results/{resultId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /brackets/{bracketId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Teams
    match /teams/{teamId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.leaderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if true;
        allow write: if signedIn();
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAdmin() || (signedIn() && (resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid || resource.data.isGlobal == true));
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Support Tickets & Messages
    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.userId == request.auth.uid || resource.data.uid == request.auth.uid));
      allow create: if signedIn();
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || signedIn();
        allow create: if signedIn();
        allow update, delete: if isAdmin();
      }
    }

    // Referrals
    match /referrals/{referralId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Settings, Announcements, Banners, FAQs
    match /paymentSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /appSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /resultConfigurations/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SSO Tokens (short lived, single use)
    match /ssoTokens/{tokenId} {
      allow read, write: if signedIn();
    }
  }
}
